---
import Base from "../../layouts/Base.astro";
import ServiceDetail from "../../components/ServiceDetail.astro";
import { es, alternateServiceSlug } from "../../i18n";
import { serviceJsonLd, breadcrumbJsonLd } from "../../seo";

export function getStaticPaths() {
  return es.services.items.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const dict = es;
const page = dict.servicePages[slug!];
const alternatePath = `/en/services/${alternateServiceSlug(slug!, "es")}/`;
const jsonLd = [
  serviceJsonLd("es", slug!, dict, Astro.site),
  breadcrumbJsonLd("es", slug!, dict, Astro.site),
];
---

<Base
  locale="es"
  lang="es"
  dict={dict}
  title={page?.metaTitle}
  description={page?.metaDescription}
  alternatePath={alternatePath}
  jsonLd={jsonLd}
>
  <ServiceDetail locale="es" dict={dict} slug={slug!} />
</Base>
