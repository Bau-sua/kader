---
import Base from "../../../layouts/Base.astro";
import ServiceDetail from "../../../components/ServiceDetail.astro";
import { en, alternateServiceSlug } from "../../../i18n";
import { serviceJsonLd, breadcrumbJsonLd } from "../../../seo";

export function getStaticPaths() {
  return en.services.items.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const dict = en;
const page = dict.servicePages[slug!];
const alternatePath = `/servicios/${alternateServiceSlug(slug!, "en")}/`;
const jsonLd = [
  serviceJsonLd("en", slug!, dict, Astro.site),
  breadcrumbJsonLd("en", slug!, dict, Astro.site),
];
---

<Base
  locale="en"
  lang="en"
  dict={dict}
  title={page?.metaTitle}
  description={page?.metaDescription}
  alternatePath={alternatePath}
  jsonLd={jsonLd}
>
  <ServiceDetail locale="en" dict={dict} slug={slug!} />
</Base>
