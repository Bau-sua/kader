---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import type { Translations } from "../i18n";
import type { JsonLd } from "../seo";

interface Props {
  locale: "es" | "en";
  lang: string;
  dict: Translations;
  title?: string;
  description?: string;
  // Ruta equivalente en el otro idioma (para hreflang y el switcher).
  // Si no se pasa, se asume que es la home del otro idioma.
  alternatePath?: string;
  // Datos estructurados (JSON-LD) específicos de la página
  jsonLd?: JsonLd[];
}

const { locale, lang, dict, title, description, alternatePath, jsonLd } = Astro.props;

// Canonical: siempre la URL real de la página actual (no hardcodeada)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Alternate: ruta equivalente en el otro idioma
const alternate = alternatePath ?? (locale === "es" ? "/en/" : "/");
const alternateUrl = new URL(alternate, Astro.site);
const esUrl = locale === "es" ? canonicalUrl : alternateUrl;
const enUrl = locale === "en" ? canonicalUrl : alternateUrl;

const htmlTitle = title ?? dict.meta.title;
const htmlDescription = description ?? dict.meta.description;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{htmlTitle}</title>
    <meta name="description" content={htmlDescription} />

    <!-- Tema: oscuro por defecto; respeta la preferencia guardada (sin flash) -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.classList.remove("dark");
          }
        } catch (e) {}
      })();
    </script>

    <!-- SEO / alternates -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "es" ? "es_AR" : "en_US"} />
    <meta property="og:site_name" content={dict.meta.title} />
    <meta property="og:title" content={htmlTitle} />
    <meta property="og:description" content={htmlDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.title} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={htmlTitle} />
    <meta name="twitter:description" content={htmlDescription} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site).href} />

    <!-- Datos estructurados (schema.org) -->
    {
      jsonLd?.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }

    <!-- Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Nav locale={locale} dict={dict} alternate={alternate} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} dict={dict} />

    <!-- Analytics y Speed Insights de Vercel -->
    <Analytics />
    <SpeedInsights />

    <!-- Reveal on scroll (respetando prefers-reduced-motion) -->
    <script is:inline>
      const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReduced) {
        const els = document.querySelectorAll(".reveal");
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
          );
          els.forEach((el) => io.observe(el));
        } else {
          els.forEach((el) => el.classList.add("is-visible"));
        }
      } else {
        document.querySelectorAll(".reveal").forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
