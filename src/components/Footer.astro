---
import { site } from "../site.config";
import Logo from "./Logo.astro";
import type { Translations } from "../i18n";

interface Props {
  locale: "es" | "en";
  dict: Translations;
}

const { locale, dict } = Astro.props;
const year = new Date().getFullYear();
const brandHref = locale === "es" ? "/" : "/en/";

const socials = [
  { href: site.socials.instagram, label: "Instagram", icon: "Instagram" },
].filter((s) => s.href.length > 0);
---

<footer class="border-t border-hairline">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-8 px-6 py-14 md:flex-row md:justify-between lg:px-8">
    <div class="flex flex-col items-center gap-2 text-center md:items-start md:text-left">
      <a href={brandHref} class="flex items-center text-ink transition-colors duration-300 hover:text-bronze">
        <Logo size={28} wordmarkClass="font-serif text-base font-medium tracking-wide" />
      </a>
      <p class="text-sm font-light text-muted">{dict.footer.tagline}</p>
    </div>

    <div class="flex flex-col items-center gap-4 md:items-end">
      {
        socials.length > 0 && (
          <div class="flex items-center gap-6">
            <span class="text-[11px] tracking-[0.28em] uppercase text-muted">{dict.footer.social}</span>
            {
              socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.label}
                  class="text-sm text-muted transition-colors duration-300 hover:text-bronze"
                >
                  {social.icon}
                </a>
              ))
            }
          </div>
        )
      }
      <p class="text-xs font-light text-muted/80">
        © {year} {site.name}. {dict.footer.rights}
      </p>
    </div>
  </div>
</footer>
